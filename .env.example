# Supabase — public client (read-only + contact form insert)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role, server-only. Never expose to client components.
SUPABASE_SERVICE_ROLE_KEY=

# Groq — AI bio generation (/api/summarize)
GROQ_API_KEY=

# Legacy dashboard password gate (PasswordGate). Superseded by
# Supabase Auth once M2 lands; kept alive in parallel until then.
DASHBOARD_PASSWORD=

# GitHub — optional, raises rate limit for /api/summarize's profile/repo fetch
GITHUB_TOKEN=
